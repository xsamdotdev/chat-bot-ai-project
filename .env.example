# Docker Compose environment (repo-root .env — next to compose.yaml).
# Copy me:  cp .env.example .env   (then fill in the blanks)
#
# `docker compose` reads THIS file for ${VAR} interpolation.
# backend/.env is only used when running uvicorn locally (not via Docker).

PROVIDER=gemini

# --- Google Gemini (LLM) ---
GOOGLE_API_KEY=          # or GEMINI_API_KEY
GOOGLE_CHAT_MODEL=gemini-2.5-flash

# --- Pinecone (embeddings + vector store) ---
PINECONE_API_KEY=
PINECONE_INDEX=chat-bot-vectors     # standard vector index: dimension 1024, metric cosine
# PINECONE_HOST=https://chat-bot-vectors-xxxx.svc.aped-1234.pinecone.io
PINECONE_NAMESPACE=
PINECONE_EMBEDDING_MODEL=llama-text-embed-v2

# --- Optional ---
BACKEND_PORT=8000
CORS_ORIGINS=*
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
