# ---------------------------------------------------------------------------
# Stack: Gemini (LLM) + Pinecone (embeddings + vector store).
#   PROVIDER=gemini  -> Gemini chat, Pinecone hosted embeddings + Pinecone index
#   PROVIDER=fake    -> offline stubs (tests/smoke checks only)
# ---------------------------------------------------------------------------
PROVIDER=gemini

# --- Google Gemini (LLM) ---
GOOGLE_API_KEY=          # or GEMINI_API_KEY
GOOGLE_CHAT_MODEL=gemini-2.5-flash
# GOOGLE_BASE_URL=       # only for proxies/gateways

# --- Pinecone (embeddings + vector store) ---
PINECONE_API_KEY=
# Either the index name, or the full host URL (copy it from the console):
PINECONE_INDEX=          # e.g. chat-bot-idx   (dimension must match the embedding model)
# PINECONE_HOST=https://chat-bot-idx-xxxx.svc.aped-1234.pinecone.io
PINECONE_NAMESPACE=      # optional; empty = default namespace
# Hosted embedding model (dense, 1024-dim): llama-text-embed-v2 | multilingual-e5-large
PINECONE_EMBEDDING_MODEL=llama-text-embed-v2

# --- Chunking / retrieval (defaults are sensible) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=50

# --- CORS (comma separated; * allows everything - dev only) ---
CORS_ORIGINS=*
