# ---------------------------------------------------------------------------
# Provider selection: openai | ollama | mistral | fake
#   openai -> uses OPENAI_* settings below (also works with OpenAI-compatible
#             endpoints such as Groq/Together/local proxies via OPENAI_BASE_URL)
#   ollama -> uses OLLAMA_* settings; requires `ollama serve` running locally
#   mistral -> Mistral AI API (MISTRAL_API_KEY); chat + mistral-embed
#   fake   -> fully offline deterministic stub (dev/smoke tests only, not smart)
# ---------------------------------------------------------------------------
PROVIDER=fake

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Mistral AI ---
MISTRAL_API_KEY=
MISTRAL_BASE_URL=
MISTRAL_CHAT_MODEL=mistral-small
MISTRAL_EMBEDDING_MODEL=mistral-embed

# --- Chunking / retrieval (defaults are sensible) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=50

# --- CORS (comma separated; * allows everything - dev only) ---
CORS_ORIGINS=*
